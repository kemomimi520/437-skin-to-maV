@unit 1080
@include script_def.mui

_head-t
    type=1
    lang=920
    fsize=50
    anchor=4
    pos=50%,100%-{p_title_y}
    zindex=2
_list
    type=101
    size={p_list_w},{p_list_h}
    anchor=4
    pos=50%,50%+20
    tex=g-empty.png
    size3=0,100
_scroll
    tex=g-scroll.png
    size=2,{p_list_h}
    anchor=5
    pos=50%+428,50%+20
_scrollbar
    tex=g-scrollbar.png
    size=7,138
    anchor=8
    parent=_scroll
    pos=2,0
_button
    type=4
    tex=g-dialogbtn.png
    tex2=g-dialogbtn2.png
    part=7,46
    size=220,68
    anchor=1
    pos=50%,{p_btn_y}
    etag=119
    tag=1
    hover=g-dialogbtn2.png
    press=g-dialogbtn2.png
    leave=g-dialogbtn.png
    release=g-dialogbtn.png
_buttonstr
    type=1
    lang=113
    fsize=32
    anchor=4
    pos=110,34
    parent=_button
+item
_item
    size={p_list_w},{p_item_h}+{p_item_p}
_itembg
