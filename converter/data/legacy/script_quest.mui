    size=0,{p_item_p}
    anchor=4
    parent=_item
    pos=63,64+31
    zindex=2
    tag=1
_item-title
    type=1
    fsize=24
    anchor=6
    parent=_item
    pos=123,80+31
    zindex=2
    tag=2
_item-desc
    type=1
    fsize=24
    size2=600,0
    anchor=6
    parent=_item
    pos=_item-title 0,-26
    zindex=2
    tag=3
_item-exp
    type=1
    fsize=24
    color=#F5AC47
    anchor=6
    parent=_item
    pos=_item-title 0,-70
    zindex=2
    tag=4
_item-progress
    type=106
