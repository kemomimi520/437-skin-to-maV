@apply soundend
@define ring 360
@if 1.4
@unit 672
@define ring 336
@endif
@if 1.65
@unit 576
@define ring 288
@endif
@if 1.95
@unit 536
@define ring 286
@endif
#
:ani-press-1
    name=r,from=0,to=360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1800,-1500)
    name=move,from=(50%-280,{ring}-30),to=(50%-353.6,{ring}+131.6),atime=(-1450,-1100)
#
:ani-press-23
    name=r,from=0,to=360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1800,-1500)
#
:ani-press-4
    name=r,from=0,to=360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1800,-1500)
    name=move,from=(50%-280,{ring}-30),to=(50%-353.6,{ring}-191.6),atime=(-1450,-1100)
#
:ani-press-5
    name=r,from=0,to=-360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1800,-1500)
    name=move,from=(50%+280,{ring}-30),to=(50%+353.6,{ring}-191.6),atime=(-1450,-1100)
#
:ani-press-67
    name=r,from=0,to=-360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1800,-1500)
#
:ani-press-8
    name=r,from=0,to=-360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1800,-1500)
    name=move,from=(50%+280,{ring}-30),to=(50%+353.6,{ring}+131.6),atime=(-1450,-1100)
#
:press-a
    name=r,from=0,to=360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1100,-1000)
#
:press-a2
    name=r,from=0,to=-360,atime=(-2000,0),repeat=999999
    name=f,from=0,to=100,atime=(-1100,-1000)
#
:rota
    name=r,from=0,to=360,atime=(-2000,0),repeat=999999
#
:rota2
    name=r,from=0,to=-360,atime=(-2000,0),repeat=999999
#
:rota3
    name=r,from=0,to=360,atime=(-2000,6000),repeat=999999
#
:rota4
    name=r,from=0,to=-360,atime=(-2000,6000),repeat=999999
#
:rotb
    name=r,from=0,to=360,atime=(-2000,0),repeat=999999
    name=size,from=(204,204),to=(225,225),atime=(-2000,-1800),repeat=(999999,200)
    name=size,from=(225,225),to=(204,204),atime=(-1800,-1600),repeat=(999999,200)
#
:rotb2
    name=r,from=0,to=-360,atime=(-2000,0),repeat=999999
    name=size,from=(204,204),to=(225,225),atime=(-2000,-1800),repeat=(999999,200)
    name=size,from=(225,225),to=(204,204),atime=(-1800,-1600),repeat=(999999,200)
#
:rotc
    name=r,from=0,to=-360,atime=(-2000,0),repeat=999999
    name=f,from=10,to=50,atime=(-1000,-400),repeat=(999999,600)
    name=f,from=50,to=10,atime=(-400,200),repeat=(999999,600)
#
:rotc2
    name=r,from=0,to=360,atime=(-2000,0),repeat=999999
    name=f,from=10,to=50,atime=(-1000,-400),repeat=(999999,600)
    name=f,from=50,to=10,atime=(-400,200),repeat=(999999,600)
