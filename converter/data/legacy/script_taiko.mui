@unit 1080

### All variables depend on whether widescreen or not
# For screen ratio >= 1.4
@define HP_Y 875

@define TOUCHAREA_W 518.4
@define TOUCHDRUM_H 540
@define TOUCHDRUM_HINT_X -35
@define TOUCHDRUM_HINT_W_R 259.2
@define TOUCHDRUM_HINT_W_B 648

@define TRACK_H 264
@define TRACK_DRUM_X 195
@define TRACK_JUDGE_H 165

@define TRACK_RENDA1_FSIZE 44
@define TRACK_RENDA2_FSIZE 56
@define TRACK_BALLOON_FSIZE 50
@define TRACK_BALLOON_NUM_X 149

@define HIT_BG_H 170
@define HIT_TOP_H 360
@define HIT_CHAR_H 63

@define NOTE_SMALL_H 120
@define NOTE_LARGE_H 169.8
@define NOTE_BALLOON_H 160
@define NOTE_BARLINE_H 210
@define NOTE_BEGINPOS_X 1488

@define COMBO_FSIZE 72

@define ANIM_COMBO_H1 81
@define ANIM_COMBO_H2 72
@define ANIM_FLYINGNOTE_X2 750
@define ANIM_FLYINGNOTE_Y2 220
@define ANIM_SPLASHBIG_W1 280
@define ANIM_SPLASHBIG_W2 360
@define ANIM_HITCHAR_Y1 765
@define ANIM_HITCHAR_Y2 785

# For screen ratio < 1.4
@if <1.4
@define HP_Y 842

@define TOUCHAREA_W 432
@define TOUCHDRUM_H 450
@define TOUCHDRUM_HINT_X -29
@define TOUCHDRUM_HINT_W_R 216
@define TOUCHDRUM_HINT_W_B 540

@define TRACK_H 198
@define TRACK_DRUM_X 146.25
@define TRACK_JUDGE_H 123.75

@define TRACK_RENDA1_FSIZE 33
@define TRACK_RENDA2_FSIZE 42
@define TRACK_BALLOON_FSIZE 38
@define TRACK_BALLOON_NUM_X 112

@define HIT_BG_H 127.5
@define HIT_TOP_H 270
@define HIT_CHAR_H 47.5

@define NOTE_SMALL_H 90
@define NOTE_LARGE_H 127.35
@define NOTE_BALLOON_H 120
@define NOTE_BARLINE_H 157.5
@define NOTE_BEGINPOS_X 1116

@define COMBO_FSIZE 54

@define ANIM_COMBO_H1 61
@define ANIM_COMBO_H2 54
@define ANIM_FLYINGNOTE_X2 560
@define ANIM_FLYINGNOTE_Y2 200
@define ANIM_SPLASHBIG_W1 210
@define ANIM_SPLASHBIG_W2 270
@define ANIM_HITCHAR_Y1 750
@define ANIM_HITCHAR_Y2 765
@endif

## Animations ##

:ani-touchdrum-sink
	name=move,time=(0,300),from=(50%,-30),to=(50%,0)
:ani-touchdrum-hintfade
	name=fade,time=(0,250),from=60,to=0,trans=(0.5,0,0.5,0)
	
:ani-trackdrum-hitmark-showup
	name=fade,time=(0,100),from=100,to=20,trans=(0.7,0,0.7,0)
#	name=hide,time=(100,100)
#	name=show,time=(0,100)
	
:ani-combo-bounce
	name=height,time=(0,160),from={ANIM_COMBO_H1},to={ANIM_COMBO_H2}
	
:ani-flyingnote
	name=movex,atime=(0,450),from=0,to={ANIM_FLYINGNOTE_X2}
	name=movey,atime=(0,450),from=0,to={ANIM_FLYINGNOTE_Y2},trans=(0.3,1,0.65,1.3)
	name=fade,atime=(300,450),from=100,to=0
	name=hide,atime=(450,450)
	
:ani-splash-bg
	name=fade,atime=(0,240),from=100,to=100
	name=fade,atime=(240,480),from=100,to=0
	name=hide,atime=(480,480)
:ani-splash
	name=fade,atime=(0,120),from=100,to=100
	name=fade,atime=(120,200),from=100,to=0
	name=hide,atime=(200,200)
:ani-splash-big
	name=fade,atime=(0,40),from=0,to=100
	name=size,atime=(0,160),from=({ANIM_SPLASHBIG_W1},{ANIM_SPLASHBIG_W1}),to=({ANIM_SPLASHBIG_W2},{ANIM_SPLASHBIG_W2}),trans=(0.5,1,0.5,1)
	name=fade,atime=(80,160),from=100,to=0
	name=hide,atime=(160,160)
:ani-hitchar
	name=movey,atime=(0,80),from={ANIM_HITCHAR_Y1},to={ANIM_HITCHAR_Y2}
	name=fade,atime=(0,160),from=100,to=100
	name=fade,atime=(160,360),from=100,to=0
	
## Global Components ##
	
_bg-shade-top
	pos=0,100%
	size=100%,232
	tex=taiko-bg-top.png
	anchor=0
	zindex=1
	
score-hp
	type=0
	tex=taiko-hpbar1.png
	pos=0,{HP_Y}
	size=1082,44
	anchor=3
	zindex=9
_score-hp
	type=0
	tex=taiko-hpbar1.png
	pos=score-hp 0,0
	size=1082,44
	anchor=3
	zindex=9
	opacity=30
_hp-bg
	tex=taiko-hpbar0.png
	pos=score-hp 0,0
	size=1082,44
	anchor=3
	zindex=8

## Touchdrum ##
+touchdrum

# The touch area. Currently only round area (type=2) are supported.
# Anywhere inside the touch area is recognized as Dong, Ka vise versa.
# Default size for big hits in 16:9 ratio is given below.
# In game those values are calculated as rect:rect2:rect3 = 0.48:0.24:0.6
touch
	type=2
	rect=50%,-35,{TOUCHAREA_W},0
#	rect=50%,-35,518.4,0
#	rect=50%,-35,259.2,0  # dong big hit
#	rect=50%,-35,648,0    # ka big hit outer border
	
_touchdrum
	pos=50%,0
	opacity=40
	zindex=18
	action=ani-touchdrum-sink

_touchdrum-bg
	tex=taiko-touchdrum.png
	parent=_touchdrum
	pos=0,0
	anchor=7
	size=0,{TOUCHDRUM_H}

_touchdrum-hint-inner-bighit
	tex=taiko-touchdrum-hint1.png
	parent=_touchdrum
	pos=0,{TOUCHDRUM_HINT_X}
	anchor=7
	size=0,{TOUCHDRUM_HINT_W_R}
	opacity=0
	action=ani-touchdrum-hintfade

_touchdrum-hint-outer-bighit
	tex=taiko-touchdrum-hint2.png
	parent=_touchdrum
	pos=0,{TOUCHDRUM_HINT_X}
	anchor=7
	size=0,{TOUCHDRUM_HINT_W_B}
	opacity=0
	action=ani-touchdrum-hintfade
	
## Tracks ##
+track-1

# compensate for the 1 pixel error of 3-part sprites
@define TRACK_BG_H {TRACK_H}-1

_track-1-bg
	type=4
	tex=taiko-track.png
	zindex=-1
	anchor=3
	size=100%,{TRACK_BG_H}
	part=350px,360px
	pos=0,700
# for screens with larger ratio, we move the track drum to the right and add a cover image on the left.
@if >1.778
	pos=50%-960,700
	size=1920,{TRACK_BG_H}
@endif
# for screens with relatively smaller ratio, we move the track drum a little to the left.
@if <1.72
	pos=100%-1857.6,700
	size=1858,{TRACK_BG_H}
@endif
# for screens with rather smaller ratio, the track drum would be outside screen, so stop move it any more to the left.
@if <1.68
	pos=-43.2,700
	size=100%+44,{TRACK_BG_H}
@endif
# for screens with narrow ratio, we choose despair. scaling the track would be sufficient.
@if <1.4
	pos=0,700
	size=100%,{TRACK_BG_H}
@endif


# a rect indicating outside which area should notes and barlines be removed from screen.
# set this rect larger if unnecessary note removal happened.
_track-1-rect
	anchor=6
	size=100%,100%
	pos=0,0

_track-1-judge
	tex=taiko-track-judge.png
	size=0,{TRACK_JUDGE_H}
	anchor=4
	pos=_track-1-bg 100%-1410,0
@if >1.778
	pos=_track-1-bg 1920-1410,0
@endif
@if <1.72
	pos=_track-1-bg 448,0
@endif
@if <1.4
	size=0,123.75
	pos=_track-1-bg 100%-1057.5,0
@endif
@if <1.3
	pos=_track-1-bg 346.5,0
@endif

# every note will be added under this node. 
_track-1-notes
	pos=_track-1-judge 0,0
	zindex=4
	
_track-1-barlines
	pos=_track-1-judge 0,0
	zindex=3

# cover image for screen ratio > 16:9
@if >1.778
_track-1-cover-[1-2]
	tex=taiko-track-cover.png
	size=0,{TRACK_H}
	zindex=5
_track-1-cover-1
	anchor=5
	pos=_track-1-bg 0,0
_track-1-cover-2
	anchor=3
	pos=_track-1-bg 1920,0
@endif
	
_track-1-drum
	tex=taiko-trackdrum.png
	size=0,{TRACK_H}
	pos=_track-1-bg {TRACK_DRUM_X},0
	anchor=4
	zindex=5
	
_track-1-drum-hitmark-[1-4]
	anchor=5
	zindex=5
	opacity=20
	action=ani-trackdrum-hitmark-showup
	pos=_track-1-drum 0,0
	size=0,{TRACK_H}
_track-1-drum-hitmark-[1,4]
	tex=taiko-trackdrum-leftouter.png
	zindex=6
_track-1-drum-hitmark-[2,3]
	tex=taiko-trackdrum-leftinner.png
	zindex=5
_track-1-drum-hitmark-[3,4]
	flip=0
	anchor=3

_track-1-renda-num-[1-2]
	anchor=4
	zindex=6
	type=0
	frame=font-taiko/0-9
	fsize={TRACK_RENDA1_FSIZE}
	pos=_track-1-judge 0,0
	pos2=0.7px,0
	interval=10
_track-1-renda-num-2
	fsize={TRACK_RENDA2_FSIZE}
	
_track-1-balloon-num
	anchor=4
	zindex=6
	type=0
	frame=font-taiko/0-9
	fsize={TRACK_BALLOON_FSIZE}
	pos=_track-1-judge {TRACK_BALLOON_NUM_X},0
	pos2=0.7px,0
	interval=10

## Effects ##
+effects

# Note on type2:
# type2=0 means new effect will not interrupt previous one;
#         interval should be set for images(type=0) to have effect removed on desired time.
# type2=1 means new effect will interrupt previous one;
# type2=2 means only small hit (1, 3) interrupts, big hit (2, 4) doesn't;

hitbg-1
	type=0
    anchor=4
    size=0,{HIT_BG_H}
	pos=_track-1-judge 0,0
    zindex=3
	type2=1
	action=ani-splash-bg
	action2=ani-splash-bg
	tex=taiko-hitbg-1a.png
	tex2=taiko-hitbg-1b.png
	tex3=taiko-hitbg-2a.png
	tex4=taiko-hitbg-2b.png

hit-1
    anchor=4
    size=0,{HIT_TOP_H}
	pos=_track-1-judge 0,0
    zindex=5
	interval=40
	type2=2
	action=ani-splash
	action2=ani-splash-big
	frame=taiko-hit-1/2-3~
	frame2=taiko-hit-1/5-5~
	frame3=taiko-hit-2/2-3~
	frame4=taiko-hit-2/5-5~
	
hitchar-1
	type=0
    anchor=4
    size=0,{HIT_CHAR_H}
	pos=_track-1-judge 0,0
    action=ani-hitchar
    zindex=7
	type2=1
	tex=taiko-hitchar-good.png
	tex3=taiko-hitchar-ok.png
	tex5=taiko-hitchar-bad.png
	
## Notes ##
+notes

# note: the type num 1~7 each represents d,D,k,K,r,R,b
# the distance between appearing position pos and hit position pos2 is 4 beats
# note that assigning different pos to each note is possible,
# but non-horizontal motions will make the score unrankable!
note-[1-7]
	type=4
	anchor=4
	tex=taiko-notered-0.png
	size=0,{NOTE_SMALL_H}
	pos={NOTE_BEGINPOS_X},0
	pos2=0,0
note-[2,4,6]
	size=0,{NOTE_LARGE_H}
note-2
	tex=taiko-notered-big-0.png
note-3
	tex=taiko-noteblue-0.png
note-4
	tex=taiko-noteblue-big-0.png
note-5
	tex=taiko-noteyellow-0.png
	tex2=taiko-renda.png
	part=61px,122px
note-6
	tex=taiko-noteyellow-big-0.png
	tex2=taiko-renda-big.png
	part=96px,192px
note-7
	tex=taiko-noteorange-0.png
note-[1-4]
	action=ani-flyingnote
	
# tail sprite. pos is treated as a relative position to the main sprite
note-7-tail
	type=3
	pos=0,0
	size=0,{NOTE_BALLOON_H}
	frame=taiko-balloon/0-0
	frame2=taiko-balloon/1-2~
	interval=80
	anchor=3
	
bar
	tex=taiko-barline.png
	size=0,{NOTE_BARLINE_H}
	pos={NOTE_BEGINPOS_X},0
	pos2=0,0
	anchor=4
	
## Score Texts ##
+texts

# note: zindex here stands for a limit, and combo is visible when not less than the limit
score-combo
	anchor=4
	frame=font-taiko/0-9
	fsize={COMBO_FSIZE}
	pos=_track-1-drum 0,0
	pos2=0.9px,0
	type2=1
	interval=10
	zindex=10
	action=ani-combo-bounce
score-acc
	anchor=5
	frame=font-taiko-light/0-11
	fsize=50
	pos=100%-30,{HP_Y}+5
	pos2=0.8px,0
	type2=1
	interval=300
score-score
	anchor=5
	frame=font-taiko/0-9
	fsize=80
	pos=100%-30,{HP_Y}+85
	pos2=0.9px,0
	type2=0
	interval=300
