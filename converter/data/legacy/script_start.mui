@include script_loginbox.mui
@unit 1080

@define ani_x 530
@define logo_h 660

@if <1.4
@define ani_x 430
@define logo_h 500
@endif

_bg
    type=2
    size=100%,100%
    color=#152232
    anchor=6
    pos=0,0
_bar-2
    tex=ui-line1.png
    anchor=0
    pos=62,100%
    size=94,100%-36
_bar-3
    type=4
    type2=2
    tex=ui-line0.png
    part=40,144
    anchor=3
    pos=62+94,36
    size=100%-62-94-87,8
_desc-[1,2]
    type=1
    fsize=24
    anchor=8
    pos=100%-50,75$33
_desc-1
    text=Copyright Mugzone 2014-2019
_desc-2
    text=Verion 4.0.0
:line
    name=fade,to=100,t=(1500,+300)
_line-[1,3]
    tex=ui-song-bg2.png
    size=0,93
    anchor=6
    pos=50%+28,64
    zindex=1
    opacity=0
    action=line
_line-[2,4]
    tex=ui-song-bg3.png
    size=0,93
    anchor=6
    pos=50%-120,187
    opacity=0
    action=line
_line-3
    anchor=8
    pos=100%+30,100%-428
_line-4
    anchor=8
    pos=100%+105,100%-304
:logo
    name=mx,from=50%,to={ani_x},t=(1500,+300),trans=(.12,.57,.31,1)
    name=fade,to=100,t=1000
_logo
    tex=icon-ma.png
    size=0,{logo_h}
    anchor=4
    pos=50%,50%-8
    zindex=2
    opacity=0
    action=logo
@if phone
@unit 800
@endif
_btn-[1,2]
    type=4
    tex=g-dialogbtn.png
    tex2=g-dialogbtn2.png
    part=7,46
    size=297,68
    anchor=3
    pos=50%-23$363,50%
    opacity=0
    action=line
    hover=g-dialogbtn2.png
    leave=g-dialogbtn.png
    etag=127
    tag=1$1
_btnstr-[1,2]
    type=1
    fsize=32
    anchor=4
    pos=148.5,34
    tag=1
_btnstr-1
    parent=_btn-1
    lang=900
_btnstr-2
    parent=_btn-2
    lang=901

_loginbox
    zindex=5
    anchor=4
    pos=100%-548,50%+71
    show=0
_loginbox-btn-3
    etag=127
    tag=3

@if phone
_desc-[1,2]
    fsize=30
_loginbox
    pos=50%,50%
@endif