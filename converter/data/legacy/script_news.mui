@unit 1080
@include script_def.mui

_head-t
    type=1
    lang=923
    fsize=40
    anchor=4
    pos=50%,100%-{p_title_y}
    zindex=2
_list
    type=101
    size={p_list_w},{p_list_h}
    anchor=4
    pos=50%-18,50%+20
    tex=g-empty.png
    size3=0,100
_scroll
    tex=g-scroll.png
    size=2,{p_list_h}
    anchor=5
    pos=50%+428,50%+20
_scrollbar
    tex=g-scrollbar.png
    size=7,138
    anchor=8
    parent=_scroll
    pos=2,0
_button
    type=4
    tex=g-dialogbtn.png
    tex2=g-dialogbtn2.png
    part=7,46
    size=220,68
    anchor=1
    pos=50%,{p_btn_y}
    etag=120
    tag=1
    hover=g-dialogbtn2.png
    leave=g-dialogbtn.png
_buttonstr
    type=1
    lang=113
    fsize=32
    anchor=4
    pos=110,34
    parent=_button
+item
_item
    size={p_list_w},{p_item_h}+{p_item_p}
_itembg
    type=4
    tex=ui-chart-bg3.png
    part=20,60
    size={p_list_w},{p_item_h}
    anchor=6
    pos=0,{p_item_p}
    parent=_item
_item-title
    type=1
    fsize={f2}
    size2={p_list_w}-70,0
    anchor=6
    parent=_item
    pos=44,70+{p_item_p}
    zindex=2
    tag=1
_item-desc
    type=1
    fsize={f3}
    size2={p_list_w}-70,0
    anchor=6
    parent=_item
    pos=_item-title 0,-42
    zindex=2
    tag=2

@if phone
_button
    size=363,104
    pos=50%,{p_btn_y}
_buttonstr
    fsize=45
    pos=181.5,52
_scroll
    pos=50%+695,50%+20
_item-title
    pos=44,100+{p_item_p}
_item-desc
    pos=_item-title 0,-48
@endif