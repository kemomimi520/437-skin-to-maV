@include script_edit_config.mui
@include script_edit_pc.mui

@define gridW 1280w-300

@if phone
@define gridW 1280w-330
@endif

_edit
    size=100%,100%
    anchor=6
    pos=0,0
    zindex=1
    etag=105
_grids
    size=100%,100%
    anchor=6
    pos=0,0
_gridbg
    type=4
    tex=ui-edit-bg5.png
    part=10,80
    size2={gridW},100%
    anchor=6
    pos=240,0

_judge
    tex=ui-edit-keybar.png
    size={gridW},5
    anchor=6
    pos=240,60
_sample
    type=200
    tex=ui-edit-keynote0.png
    size=98px,33px
    part=40,58
    tex2=ui-edit-sliden2.png
    size2=98px,33px
    part2=40,58
    tex3=ui-edit-sliden3.png
    tex4=ui-edit-slidedot.png
    size3=0,20
    pos=0,20%
@if phone
    pos=0,15%
@endif

_right-icon3-2
    tex=ui-edit-icon12.png
    tag=1
_right-icon3-3
    tex=ui-edit-icon24.png
    tag=2
_right-icon3-4
    tex=ui-edit-icon23.png
    tag=81
_right-icon3-5
    tex=ui-edit-icon21.png
    tag=83
_right-icon3-6
    tex=ui-edit-icon20.png
    tag=85
_right-icon3-[2-6]
    show=1
_right-tip3-2
    text=Note
_right-tip3-3
    text=Wipe
_right-tip3-4
    text=Slide
_right-tip3-5
    text=Remove
_right-tip3-6
    text=More
_right-tip3-[2-6]
    show=1

_widthbar
    size={gridW},{rightW}
    anchor=6
    pos=_gridbg 0,0
    etag=104
    tag=77
    zindex=5
_widthbar-bg
    type=5
    tex=ui-edit-bg2.png
    rect=3px,3px,4px,4px
    parent=_widthbar
    size=100%,100%
    anchor=6
_widthbar-str
    type=1
    text=Width
    fsize={rightF}
    parent=_widthbar
    pos=100%-5,50%
    anchor=5
_widthnote
    type=4
    tex=ui-edit-slidew.png
    part=10,80
    size=88,16
    parent=_widthbar
    pos=0,50%
    anchor=3
