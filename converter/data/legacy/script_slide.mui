@apply 3d
@angle 45
@unit 1080

param
    size=0,120

_hp
    tex=ui-play-hp0.png
    size=0,54
    anchor=2
    pos=100%,100%-10
    zindex=101
score-hp
    type=0
    size=469,28
    type2=1
    tex=ui-play-hp1.png
    pos=100%-18,100%-10-27
    anchor=5
    zindex=102

score-score
    frame=font-number/0-14
    fsize=36
    pos=50%,100%-100
	pos2=0.5px,0
    anchor=4
    interval=300
	zindex=101
	color=#6ECAEE

score-combo
    frame=font-combo/0-14
    fsize=60
    pos=50%,100%-138
	pos2=0.9px,0
    anchor=4
    interval=150
	zindex=101

score-acc
	frame=font-number/0-14
	fsize=36
	pos=50%,100%-178
	pos2=0.5px,0
	anchor=4
	interval=300
	zindex=101
	color=#C24954
judge-1
	type=1
	frame=ui-play-score/0-3
	interval=100
	size=575,150
	pos=50%,100
	anchor=4
	zindex=50
_bg
    type=2
    color=#09090C
    opacity=85
    size=100%,100%
    anchor=6
    zindex=1
_bg2
    type=2
    color=#09090C
    opacity=85
    size=100%,120
    anchor=0
    pos=0,0
    zindex=1
_bar-[1,2]
    tex=ui-slide-bar0.png
    size=180,100%
    anchor=8
    zindex=2
    pos=1,0
_bar-2
    flip=0
    anchor=6
    pos=100%-1,0
_judgebar
    tex=ui-slide-judge.png
    size=100%,28
    anchor=3
    pos=0,0
    zindex=5
note-1
    tex=ui-slide-note0.png
    part=80,166
    size=0,24
note-2
    tex=ui-slide-note1.png
    part=21,25
    size=0,16
note-3
    tex=ui-slide-note2.png
    tex2=ui-slide-note3.png
    part2=89,128
    size2=0,24
note-[1-3]
    pos=0,100%
    pos2=0,0
note-[1,2]
    toggle=1

hit-1
    frame=ui-slide-light2/0-12
    interval=24
    size=900,600
    blend=1
    zindex=50
    frame2=ui-slide-light/0-15
    interval2=16.67
    size2=900,900
    zindex2=110
hit-3
    frame=ui-slide-light2/0-12  
    interval=24
    size=900,600
    blend=1
    zindex=50
    toggle=1 
    frame2=ui-slide-light/5-15
    interval2=16.67
    size2=900,900
    zindex2=110
    toggle2=1